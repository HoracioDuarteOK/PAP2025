<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Sistema de Biblioteca Comunitaria</display-name>
    <description>Aplicación web para gestión de biblioteca comunitaria</description>

    <!-- Configuración de sesiones -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Página de bienvenida -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Filtro para autenticación -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>pap2025.web.filtros.AuthFilter</filter-class>
    </filter>
    
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/app/*</url-pattern>
    </filter-mapping>

    <!-- Servlets de autenticación -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.LoginServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.LogoutServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Servlets de gestión de usuarios -->
    <servlet>
        <servlet-name>GestionUsuariosServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.GestionUsuariosServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>GestionUsuariosServlet</servlet-name>
        <url-pattern>/app/gestion-usuarios</url-pattern>
    </servlet-mapping>

    <!-- Servlets de gestión de materiales -->
    <servlet>
        <servlet-name>GestionMaterialesServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.GestionMaterialesServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>GestionMaterialesServlet</servlet-name>
        <url-pattern>/app/gestion-materiales</url-pattern>
    </servlet-mapping>

    <!-- Servlets de gestión de préstamos -->
    <servlet>
        <servlet-name>GestionPrestamosServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.GestionPrestamosServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>GestionPrestamosServlet</servlet-name>
        <url-pattern>/app/gestion-prestamos</url-pattern>
    </servlet-mapping>

    <!-- Servlets para lectores -->
    <servlet>
        <servlet-name>LectorServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.LectorServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LectorServlet</servlet-name>
        <url-pattern>/app/lector</url-pattern>
    </servlet-mapping>

    <!-- Servlets para bibliotecarios -->
    <servlet>
        <servlet-name>BibliotecarioServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.BibliotecarioServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>BibliotecarioServlet</servlet-name>
        <url-pattern>/app/bibliotecario</url-pattern>
    </servlet-mapping>

    <!-- Nuevos servlets para funcionalidades completas -->
    <servlet>
        <servlet-name>RegistrarLectorServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.RegistrarLectorServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>RegistrarLectorServlet</servlet-name>
        <url-pattern>/bibliotecario/usuarios/registrar-lector</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>RegistrarBibliotecarioServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.RegistrarBibliotecarioServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>RegistrarBibliotecarioServlet</servlet-name>
        <url-pattern>/bibliotecario/usuarios/registrar-bibliotecario</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ModificarEstadoLectorServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.ModificarEstadoLectorServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>ModificarEstadoLectorServlet</servlet-name>
        <url-pattern>/bibliotecario/usuarios/modificar-estado</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CambiarZonaLectorServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.CambiarZonaLectorServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>CambiarZonaLectorServlet</servlet-name>
        <url-pattern>/bibliotecario/usuarios/cambiar-zona</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>RegistrarDonacionServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.RegistrarDonacionServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>RegistrarDonacionServlet</servlet-name>
        <url-pattern>/bibliotecario/materiales/registrar-donacion</url-pattern>
    </servlet-mapping>

    <!-- Configuración de error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.jsp</location>
    </error-page>

</web-app>
