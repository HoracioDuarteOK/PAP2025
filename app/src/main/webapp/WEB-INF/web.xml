<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>Sistema de Biblioteca Comunitaria</display-name>
    <description>Aplicación web para gestión de biblioteca con Servlets y JSP</description>
    
    <!-- Página de bienvenida -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Filtro de autenticación -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>pap2025.web.filtros.AuthFilter</filter-class>
    </filter>
    
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/app/*</url-pattern>
    </filter-mapping>
    
    <!-- Páginas de error -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.jsp</location>
    </error-page>
    
    <!-- Configuración de sesión -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>
    
    <!-- Configuración de codificación -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>
    
    <!-- Configuración de Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>BibliotecarioDashboardServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.BibliotecarioDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BibliotecarioDashboardServlet</servlet-name>
        <url-pattern>/app/bibliotecario/dashboard</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>LectorDashboardServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.LectorDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LectorDashboardServlet</servlet-name>
        <url-pattern>/app/lector/dashboard</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>GestionUsuariosServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.GestionUsuariosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GestionUsuariosServlet</servlet-name>
        <url-pattern>/app/gestion-usuarios</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CambiarEstadoLectorServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.CambiarEstadoLectorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CambiarEstadoLectorServlet</servlet-name>
        <url-pattern>/app/cambiar-estado-lector</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CambiarZonaLectorServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.CambiarZonaLectorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CambiarZonaLectorServlet</servlet-name>
        <url-pattern>/app/cambiar-zona-lector</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>GestionMaterialesServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.GestionMaterialesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GestionMaterialesServlet</servlet-name>
        <url-pattern>/app/gestion-materiales</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>GestionPrestamosServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.GestionPrestamosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GestionPrestamosServlet</servlet-name>
        <url-pattern>/app/gestion-prestamos</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CambiarEstadoPrestamoServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.CambiarEstadoPrestamoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CambiarEstadoPrestamoServlet</servlet-name>
        <url-pattern>/app/cambiar-estado-prestamo</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>BibliotecaSOAPServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.BibliotecaSOAPServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>BibliotecaSOAPServlet</servlet-name>
        <url-pattern>/ws/biblioteca</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ActualizarPrestamoServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.ActualizarPrestamoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ActualizarPrestamoServlet</servlet-name>
        <url-pattern>/app/actualizar-prestamo</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ReportesPorZonaServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.ReportesPorZonaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportesPorZonaServlet</servlet-name>
        <url-pattern>/app/reportes-zona</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>MaterialesPendientesServlet</servlet-name>
        <servlet-class>pap2025.web.servlets.MaterialesPendientesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MaterialesPendientesServlet</servlet-name>
        <url-pattern>/app/materiales-pendientes</url-pattern>
    </servlet-mapping>
    
</web-app>

